# Copy to api/.env and fill in. Never commit api/.env.

# Modes and kill switches
DEMO_MODE=1
DEMO_OFFLINE=0            # 1 = serve recorded fixtures, no network
PAYBACK_ENABLED=1         # 0 = block every refund instantly (UI shows "Refunds paused")
RATE_LIMIT_PER_MINUTE=30  # on /api/asks/* and /api/scenario/*
TZ=Asia/Kolkata

# Database (Supabase Postgres). Ignored when DEMO_OFFLINE=1 (SQLite is used)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Paytm Payment Gateway, STAGING ONLY (the API refuses any other value)
PAYTM_MODE=pending        # pending (no keys yet, nothing is sent) | staging
PAYTM_HOST=https://securestage.paytmpayments.com
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING

# Sarvam AI (Tamil speech)
SARVAM_API_KEY=

# LLM used only for the reply classifier and the evidence summary
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# Weather
WEATHER_LAT=13.04
WEATHER_LON=80.25

# Web origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
